<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ErikwnkCore</RootNamespace>
    <AssemblyName>ErikwnkCore</AssemblyName>
    <Authors>Erik Wink</Authors>
    <Description>Non-UI logic shared across Erik Wink's apps - GitHub self-update checking, single-instance detection, sleep prevention.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
